# Public site URL used for canonical links, sitemap and structured data.
# Use the Vercel preview URL while testing, the real domain in production.
NEXT_PUBLIC_SITE_URL=https://styleinthecitystudio.com

# Where photography is served from. Defaults to the Base44 media host.
# Set to /images/ once the photos are copied into public/images.
# NEXT_PUBLIC_IMAGE_HOST=/images/

# Optional analytics (nothing loads when these are empty).
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# --- SMTP (Hostinger mail) — server-side only, never prefix with NEXT_PUBLIC_ ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# SMTP_SECURE=true          # defaults to true on port 465, false on 587 (STARTTLS)
SMTP_USER=hello@styleinthecitystudio.com
SMTP_PASS=
# Sender shown on emails (must be the SMTP mailbox or an alias of it)
MAIL_FROM="Style In The City Studio <hello@styleinthecitystudio.com>"
# Where inquiries are delivered (defaults to SMTP_USER)
MAIL_TO=hello@styleinthecitystudio.com
# Send the visitor an acknowledgement email. Off by default because the
# Contact page promises "no autoresponders".
SEND_CONFIRMATION_EMAIL=false
